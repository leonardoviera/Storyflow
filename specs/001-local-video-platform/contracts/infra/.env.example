# Copy to .env (git-ignored) and replace every CHANGE_ME value.

POSTGRES_USER=storyflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=storyflow

MINIO_ROOT_USER=storyflow
MINIO_ROOT_PASSWORD=CHANGE_ME_min_8_chars
S3_BUCKET_ASSETS=storyflow-assets
S3_BUCKET_RENDERS=remotion-videos

LITELLM_MASTER_KEY=sk-CHANGE_ME

# Your self-hosted LLM server (any OpenAI-compatible server: vLLM, LM Studio, llama.cpp, TGI...).
# Reached only by LiteLLM, which exposes it to the app as "local-llm". The api_base must be a
# private address (10.x, 172.16-31.x, 192.168.x, *.local, *.lan, localhost, host.docker.internal);
# cloud providers are rejected by `pnpm lint:config` (constitution I).
LLM_MODEL=hosted_vllm/CHANGE_ME
LLM_API_BASE=http://192.168.1.100:8000/v1
LLM_API_KEY=none

# Host port for LiteLLM (loopback only); change if 4000 is taken.
LITELLM_HOST_PORT=4000
# Host port for the web app (loopback only); change if 3000 is taken.
WEB_HOST_PORT=3000
