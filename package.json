{
  "name": "storyflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build",
    "lint": "eslint .",
    "lint:config": "node scripts/lint-config.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:render": "docker compose run --rm --no-deps -T render-worker node --import tsx src/tools/determinism.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
